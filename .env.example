# Email to Sheets CRM: Environment Template

# Mode: mock (zero-cost offline simulation), imap, or gmail_api
EMAIL_SOURCE=mock

# IMAP settings (for Gmail, Outlook, Yahoo, or custom domain)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Destination mode: excel (local .xlsx) or google_sheets
CRM_DESTINATION=excel
EXCEL_OUTPUT_PATH=leads_crm.xlsx

# Google Sheets Configuration (if CRM_DESTINATION=google_sheets)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
